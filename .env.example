MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Vercel 連接 Private Blob 後自動注入；本機請使用 `vercel env pull .env.local`
BLOB_STORE_ID=generated-by-vercel
BLOB_WEBHOOK_PUBLIC_KEY=generated-by-vercel
VERCEL_OIDC_TOKEN=generated-by-vercel
