MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Vercel 連接 Private Blob 後自動注入；本機請使用 `vercel env pull .env.local`
BLOB_STORE_ID=generated-by-vercel
BLOB_WEBHOOK_PUBLIC_KEY=generated-by-vercel
VERCEL_OIDC_TOKEN=generated-by-vercel

# 瀏覽器推播：使用 `npx web-push generate-vapid-keys` 產生一組固定金鑰
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=https://your-production-domain.example
